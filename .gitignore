# Gens Engine — gitignore
# NOTE: Cargo.lock is intentionally NOT ignored — the workspace produces
# executables, so the lockfile is tracked for reproducible CI builds.

# Rust build artifacts
/target

# Out-of-tree plugin crates carry their own target/ dirs (the root
# `/target` rule does not match them). Phase 9 accidentally committed
# hello-plugin's (697 files, ~44 MB of binaries); P10-1 untracked them.
plugins/*/target/

# Build/export output used by tools and examples (later phases)
/dist

# Profiling / benchmark raw output (summarized evidence IS committed)
/perf-out

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local environment files — never commit secrets
.env
.env.*
*.local

# v1.1 interactive-editor smoke output (written at repo root by the
# gens-editor smoke session on CI; summarized evidence IS committed
# under docs/evidence/)
/smoke_editor_window.png
/smoke_editor_window.json
/scene.gensscene
/editor_window.png
/editor_window.json
